<?xml version="1.0" encoding="UTF-8"?>
<extension type="template" client="site" method="upgrade">
	<name>hospital_intranet</name>
	<version>0.1.0</version>
	<creationDate>2026-09</creationDate>
	<author>Hospital Santa Aurora — TI</author>
	<copyright>(C) 2026 Hospital Santa Aurora</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>TPL_HOSPITAL_INTRANET_XML_DESCRIPTION</description>
	<inheritable>1</inheritable>
	<files>
		<filename>component.php</filename>
		<filename>designsystem.php</filename>
		<filename>error.php</filename>
		<filename>index.php</filename>
		<filename>joomla.asset.json</filename>
		<filename>offline.php</filename>
		<filename>templateDetails.xml</filename>
		<folder>html</folder>
		<folder>partials</folder>
	</files>
	<media destination="templates/site/hospital_intranet" folder="media">
		<folder>css</folder>
		<folder>fonts</folder>
		<folder>images</folder>
		<folder>js</folder>
	</media>
	<positions>
		<position>mainmenu</position>
		<position>search</position>
		<position>hero</position>
		<position>alerts</position>
		<position>quick-access</position>
		<position>news</position>
		<position>protocols</position>
		<position>events</position>
		<position>breadcrumbs</position>
		<position>main-top</position>
		<position>main-bottom</position>
		<position>sidebar</position>
		<position>footer</position>
		<position>footer-menu</position>
		<position>error-404</position>
	</positions>
	<languages folder="language">
		<language tag="pt-BR">pt-BR/tpl_hospital_intranet.ini</language>
		<language tag="pt-BR">pt-BR/tpl_hospital_intranet.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="brand" label="TPL_HOSPITAL_INTRANET_FIELDSET_BRAND">
				<field name="brandName" type="text" default="Hospital" label="TPL_HOSPITAL_INTRANET_BRAND_NAME" />
				<field name="brandSubtitle" type="text" default="Santa Aurora" label="TPL_HOSPITAL_INTRANET_BRAND_SUBTITLE" />
				<field name="logoFile" type="media" types="images" label="TPL_HOSPITAL_INTRANET_LOGO" description="TPL_HOSPITAL_INTRANET_LOGO_DESC" />
			</fieldset>
			<fieldset name="hero" label="TPL_HOSPITAL_INTRANET_FIELDSET_HERO">
				<field name="heroEyebrow" type="text" default="Intranet corporativa" label="TPL_HOSPITAL_INTRANET_HERO_EYEBROW" />
				<field name="heroText" type="textarea" rows="2" default="Tudo o que você precisa para cuidar de quem importa, em um só lugar." label="TPL_HOSPITAL_INTRANET_HERO_TEXT" filter="string" />
				<field name="heroImage" type="media" types="images" label="TPL_HOSPITAL_INTRANET_HERO_IMAGE" description="TPL_HOSPITAL_INTRANET_HERO_IMAGE_DESC" />
			</fieldset>
			<fieldset name="footer" label="TPL_HOSPITAL_INTRANET_FIELDSET_FOOTER">
				<field name="footerTagline" type="text" default="Intranet Corporativa" label="TPL_HOSPITAL_INTRANET_FOOTER_TAGLINE" />
				<field name="supportTitle" type="text" default="TI Hospitalar" label="TPL_HOSPITAL_INTRANET_SUPPORT_TITLE" />
				<field name="supportText" type="textarea" rows="3" default="Suporte: ramal 2000" label="TPL_HOSPITAL_INTRANET_SUPPORT_TEXT" filter="string" />
			</fieldset>
		</fields>
	</config>
</extension>
