# Copiado para .env por scripts/install.sh (senhas vazias são geradas automaticamente).

# Endereço onde as portas são publicadas. 127.0.0.1 = só esta máquina.
# Use 0.0.0.0 para expor na rede interna.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
MAIL_UI_PORT=8025

DB_NAME=intranet
DB_USER=intranet
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=hsa_

SITE_NAME="Intranet Hospital Santa Aurora"
TIMEZONE=America/Sao_Paulo

# Super usuário inicial do /administrator.
# Usuário: só letras. Senha: mais de 12 caracteres.
ADMIN_NAME=Administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@santaaurora.example
MAIL_FROM=intranet@santaaurora.example
