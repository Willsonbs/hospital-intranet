<?xml version="1.0" encoding="utf-8"?>
<form addfieldprefix="Hospital\Component\Documentos\Administrator\Field">
	<fields name="filter">
		<field name="search" type="text" inputmode="search" label="COM_DOCUMENTOS_FILTER_SEARCH" hint="JSEARCH_FILTER" />
		<field name="state" type="status" optionsFilter="0,1" onchange="this.form.submit();" label="JSTATUS">
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>
		<field name="catid" type="category" extension="com_documentos" published="0,1" onchange="this.form.submit();" label="JCATEGORY">
			<option value="">JOPTION_SELECT_CATEGORY</option>
		</field>
		<field name="status" type="list" onchange="this.form.submit();" label="COM_DOCUMENTOS_FIELD_STATUS">
			<option value="">COM_DOCUMENTOS_FILTER_STATUS</option>
			<option value="vigente">COM_DOCUMENTOS_STATUS_VIGENTE</option>
			<option value="em_revisao">COM_DOCUMENTOS_STATUS_EM_REVISAO</option>
			<option value="obsoleto">COM_DOCUMENTOS_STATUS_OBSOLETO</option>
		</field>
		<field name="setor" type="setor" onchange="this.form.submit();" label="COM_DOCUMENTOS_FIELD_SETOR">
			<option value="">COM_DOCUMENTOS_FILTER_SETOR</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" onchange="this.form.submit();" default="a.data_publicacao DESC" validate="options" label="JGLOBAL_SORT_BY">
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.codigo ASC">COM_DOCUMENTOS_SORT_CODIGO_ASC</option>
			<option value="a.codigo DESC">COM_DOCUMENTOS_SORT_CODIGO_DESC</option>
			<option value="a.titulo ASC">COM_DOCUMENTOS_SORT_TITULO_ASC</option>
			<option value="a.titulo DESC">COM_DOCUMENTOS_SORT_TITULO_DESC</option>
			<option value="a.data_publicacao DESC">COM_DOCUMENTOS_SORT_PUBLICACAO_DESC</option>
			<option value="a.data_publicacao ASC">COM_DOCUMENTOS_SORT_PUBLICACAO_ASC</option>
			<option value="a.data_revisao ASC">COM_DOCUMENTOS_SORT_REVISAO_ASC</option>
			<option value="category_title ASC">COM_DOCUMENTOS_SORT_CATEGORIA_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field name="limit" type="limitbox" default="25" onchange="this.form.submit();" label="JGLOBAL_LIST_LIMIT" />
	</fields>
</form>
